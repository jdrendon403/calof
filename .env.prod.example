# Copiar este archivo como .env.prod y completar los valores

# Base de datos
POSTGRES_DB=sgtp
POSTGRES_USER=sgtp
POSTGRES_PASSWORD=cambia_esta_password

# Django — generar con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia_esta_clave_secreta

# Hosts permitidos — IP o dominio del PC donde corre la app
# Ejemplos: 192.168.1.100  |  mi-pc.local  |  localhost
ALLOWED_HOSTS=localhost,127.0.0.1,web

# CORS — desde donde el navegador accede a la app
CORS_ALLOWED_ORIGINS=http://localhost
